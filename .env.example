# ---------------------------------------------------------------------------
# VIA ABROAD OVERSEAS — Environment Variables
# Copy this file to .env.local for local development and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle — do not
# put secrets there.
# ---------------------------------------------------------------------------

# Canonical production site URL (no trailing slash). Used for canonical tags,
# sitemap, Open Graph, structured data, email links, and the server-side
# Turnstile hostname check. Production forms accept this exact hostname.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp contact number in E.164 format WITHOUT the "+" (e.g. 918639996069).
# This is intentionally separate from the business phone number — the
# WhatsApp floating action and hero CTA stay in a disabled/hidden state
# until this is set to a valid number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Homepage "Plan your study abroad budget" section (brief §14). Built but
# hidden until the client approves it; set to "true" and redeploy to show.
NEXT_PUBLIC_SHOW_BUDGET_SECTION=

# Social profile URLs. Leave blank to hide the corresponding footer icon.
# Only real, verified business profile URLs should be used — do not invent.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Supabase (PostgreSQL + Auth) -------------------------------------------
# Project URL and publishable key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key is SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# Used exclusively in server-only modules (API routes, Server Actions).
SUPABASE_SECRET_KEY=

# --- Resend (transactional email) -------------------------------------------
# Server-only. All email routing is env-driven — switching to a custom
# domain later is an env change + redeploy, no code change. See
# docs/DEPLOYMENT.md "When you get the domain".
RESEND_API_KEY=
# Inbox(es) that receive every new-enquiry notification. Comma-separate to
# send to several, e.g. "enquiries@yourdomain.com,viaabroadoverseas@gmail.com".
# Invalid entries are skipped with a server warning. The first address is the
# primary inbox (student replies to the confirmation email go there).
# Staff can hit "Reply" on a notification to answer the student directly.
BUSINESS_NOTIFICATION_EMAIL=viaabroadoverseas@gmail.com
# Sender identity. Until a domain is verified in Resend, leave this unset or on
# Resend's test sender (onboarding@resend.dev). IMPORTANT: the test sender can
# only deliver to the email address that owns the Resend account, so
# BUSINESS_NOTIFICATION_EMAIL must be that address, and student confirmation
# emails are skipped. Once a domain is verified, use an address on it, e.g.
# "VIA ABROAD OVERSEAS <enquiries@yourdomain.com>" — student confirmations then
# switch on automatically.
RESEND_FROM_EMAIL="VIA ABROAD OVERSEAS <onboarding@resend.dev>"

# --- Cloudflare Turnstile (bot protection) ----------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# When TURNSTILE_SECRET_KEY is unset, form submissions fail server-side
# verification by default (fail closed). Set this to "true" in LOCAL
# development only to allow testing the form flow without real Turnstile
# keys. Never set this in production.
ALLOW_UNVERIFIED_TURNSTILE_IN_DEV=false

# --- Upstash Redis (distributed rate limiting) ------------------------------
# Both values are required in deployed production runtimes. Requests fail
# closed with HTTP 503 when either is missing/invalid or Upstash is unavailable.
# In-memory limiting is restricted to local development and tests.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google Analytics 4 ------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Sentry (error monitoring) ----------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Misc ---------------------------------------------------------------
# Server-only high-entropy secret for salted request fingerprints and HMAC
# contact-pair rate-limit keys. Required in production; generate with:
# openssl rand -hex 32
ABUSE_HASH_SALT=
